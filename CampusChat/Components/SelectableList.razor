@typeparam T

<div class="list-group">
    @if (List.Any())
    {
        @foreach (T choice in List)
         {
            <button type="button"
                    class="list-group-item list-group-item-action"
                   @onclick="() => Selected.InvokeAsync(choice)">
                @ItemText(choice)
                @if (NotificationCount(choice) > 0)
                {
                    <span class="badge text-bg-secondary">@(Notifications?.Invoke(choice))</span>
                }
                </button>
        }
    }
    
</div>

@code {
    [Parameter] public required IEnumerable<T> List { get; set; }
    [Parameter] public EventCallback<T> Selected { get; set; }
    [Parameter] public required Func<T, string> ItemText { get; set; }
    [Parameter] public Func<T, int>? Notifications { get; set; }

    private int NotificationCount(T choice)
    {
        return Notifications?.Invoke(choice) ?? 0;
    }
}