@rendermode InteractiveServer
@inject UserService Us

<div class="container">
    <h1>Edit profile</h1>
    <form class="row g-3" @onsubmit="Submit">
        
        <TextInput Value="@Profile.UserName"
                   Id="Username"
                   Disabled="true">
        </TextInput>

        
        <TextInput @bind-Value="_firstname"
                   Id="First name">
        </TextInput>
        
        <TextInput @bind-Value="_lastname"
                   Id="Last name">
        </TextInput>

        <div class="d-flex align-items-center gap-3 mb-3">
            <span>Select an avatar color: </span>
            <div class="d-flex gap-2" reqired>
                <RadioInput @bind-Value="_avatarcolor"
                            ButtonColor="btn-primary"
                            Color="bg-primary">
                    <Avatar AvatarColor="bg-primary"></Avatar>
                </RadioInput>

                <RadioInput @bind-Value="_avatarcolor"
                            ButtonColor="btn-success"
                            Color="bg-success">
                    <Avatar AvatarColor="bg-success"></Avatar>
                </RadioInput>

                <RadioInput @bind-Value="_avatarcolor"
                            ButtonColor="btn-danger"
                            Color="bg-danger">
                    <Avatar AvatarColor="bg-danger"></Avatar>
                </RadioInput>
            </div>
        </div>

        @if (!_isTeacher)
        {
             <SelectInput T="Studies"
                          @bind-Value="_studies"
                          Message="Choose your studies"
                          Options="@(Enum.GetValues<Studies>().Skip(1))">
             </SelectInput>
             
            <SelectInput T="int"
                         @bind-Value="_startyear"
                         Message="Choose your starting year"
                         Options="@_years">
            </SelectInput>
        }

        <div class="input-group">
            <span class="input-group-text"
                  required>
                Write a short note about yourself
            </span>
            <textarea class="form-control" @bind="_introduction"></textarea>
        </div>

        @if (_isTeacher)
        {
        <Checkbox @bind-Value="_isAudit"
            Message="Do you want an audit role?"></Checkbox>
        }

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary">
                Submit
            </button>
        </div>
        
        <div class="col-md-2">
            <button type="button" 
                    class="btn btn-primary"
                    @onclick='() => Nav.NavigateTo($"/Profiles/{Profile.UserName}")'>
                Cancel
            </button>
        </div>
        

    </form>
</div>


@inject NavigationManager Nav

@code {
    [Parameter] public required Profile Profile { get; set; }
    private string _firstname = "";
    private string _lastname = "";
    private Studies _studies;
    private int _startyear = -1;
    private string _introduction = "";
    private string _avatarcolor = "";
    private bool _isTeacher;
    private bool _isAudit;

    private void Submit()
    {
        Profile editedProfile = Profile with
        {
            FirstName = _firstname,
            LastName = _lastname,
            Studies = _studies,
            StartYear = _startyear,
            Introduction = _introduction,
            AvatarColor = _avatarcolor,
            Audit = _isAudit
            
        };
        
        Us.SaveProfile(editedProfile);

        Nav.NavigateTo($"/Profiles/{Profile.UserName}");

    }
    protected override void OnInitialized()
    {
        if (Profile == null) return;
        
        _firstname = Profile.FirstName;
        _lastname = Profile.LastName;
        _studies = Profile.Studies;
        _startyear = Profile.StartYear;
        _introduction = Profile.Introduction;
        _avatarcolor = Profile.AvatarColor;
        _isTeacher = Profile.Teacher;
        _isAudit = Profile.Audit;
    }

    // TODO: Fix this 
    private readonly List<int> _years =
    [
        2024,
        2025,
        2026,
        2027
    ];
}