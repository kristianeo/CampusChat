@rendermode InteractiveServer
@inject ThreadService Ts
@inject UserService Us

@if (_thread != null)
{
    <h1>@_thread.Title</h1>
    <textarea class="form-control" 
          rows="5" 
          id="comment" readonly>
        @ThreadContent
    </textarea>
    <ThreadInput ThreadId="@_thread.Id" OnMessageAdded="@RefreshMessages"></ThreadInput>
}

@code {
    [Parameter] public string? ThreadId { get; set; }
    private string ThreadContent { get; set; } = "";
    private ChatThread? _thread;
    
    private void RefreshMessages()
    {
        ThreadContent = Ts.ReadAllMessages(ThreadId!);
    }
    protected override async Task OnParametersSetAsync()
    {
        _thread = await Us.LoadThreadAsync();

        if (_thread != null)
        {
            ThreadContent = Ts.ReadAllMessages(_thread.Id);
        }
    }
    

    //TODO: Fix possible null reference 
   
}