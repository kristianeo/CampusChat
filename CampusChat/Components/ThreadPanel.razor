@rendermode InteractiveServer
@inject ThreadService Ts
@inject UserService Us
@inject NotificationService Ns
@inject NavigationManager Nav
@implements IDisposable

<SplitPanel>
    <LeftContent>
        <NavBar IsLoggedIn="_isLoggedIn"
                User="User"/>

        <input class="form-control"
               type="text" 
               @bind="_search"
               placeholder="Search"
               @bind:event="oninput" />

        <div class="flex-grow-1 overflow-auto">
            <SelectableList T="ChatThread"
                            List="Filtered"
                            ItemText="GetThreadTitle"
                            Notifications="Notifications"
                            Selected="Choose" />
        </div>
    </LeftContent>

    <Header>
        <RightPanelHeader Thread="@ThreadTitle"
                          IsLoggedIn="_isLoggedIn">
            <Button>
                @if (_canAccess)
                {
                    <JoinOrLeaveThreadButton Thread="_thread"
                        User="User"/>
                }
            </Button>
        </RightPanelHeader>
        
    </Header>

    <Body>
    @if (_thread != null)
    {
        @if (!_canAccess)
         {
             <PrivateThread CanAccess="_canAccess"
                            ThreadPassword="@_thread!.AccessCode"
                            IsValid="HandleChangedAccess"
                            User="User">
            </PrivateThread>
        }

        else if (_canAccess && ThreadContent.Any())
        {
            @foreach (var post in ThreadContent.Where(p => p.ParentPostId == ""))
            {
                <PostItem Post="post" 
                          ThreadContent="ThreadContent"
                          @bind-ParentPostId="@_parentPostId">
                </PostItem>
            }
        }
        else if (ThreadContent.Count == 0)
        {
             <p class="lead">Be the first to post in this thread!</p>
        }
    }
    
    else if(_threadNotExist)
    {
        <p class="lead">The thread you are trying to reach does not exist.</p>
        <p class="lead">Please chose a thread from the list.</p>
    }
    
    else if (_thread == null)
    {
        <p class="lead">Choose a thread to get started</p>
    }
    
    </Body>

    <Footer>
        <MessageInput OnSend="SendMessage"
                      Disabled="@(!_isLoggedIn || !_canAccess)"/>
    </Footer>

</SplitPanel>

@code
{
    [Parameter] public string ThreadTitle { get; set; } = "";
    [Parameter] public bool ShowJoinedThreads { get; set; }
    private List<Post> ThreadContent { get; set; } = [];
    private ChatThread? _thread;
    private bool _threadNotExist;
    private List<ChatThread> _allThreads = [];
    private List<ChatThread> _joinedThreads = [];
    private Profile? User { get; set; }
    private bool _isLoggedIn;
    private string _search = "";
    private string? _parentPostId = "";
    private bool _canAccess = true;
    
    protected override void OnInitialized()
    {
        _allThreads = Ts.GetThreads();
        
        Ts.NewMessages += HandleNewMessages;
        Ts.ThreadsChanged += HandleEditedThread;
    }
    
    protected override void OnParametersSet()
    {
        LoadCurrentThread();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            User = await Us.LoadUserAsync();
            
            _isLoggedIn = User != null;
            
            if (_isLoggedIn)
            {
                _joinedThreads = Ts.GetJoinedThreads(User!.UserName);
            }
            
            UpdateAccess();
        
            StateHasChanged();
        }
    }
    
    private Task Choose(ChatThread thread)
    {
        ReadPosts(thread);
        Nav.NavigateTo(
            ShowJoinedThreads
                ? $"/Threads/JoinedThreads/{Uri.EscapeDataString(thread.Title)}"
                : $"/Threads/{Uri.EscapeDataString(thread.Title)}");

        return Task.CompletedTask;
    }
    
    private void LoadCurrentThread()
    {
        if (ThreadTitle == "JoinedThreads" || string.IsNullOrWhiteSpace(ThreadTitle))
            return;
        
        _thread = _allThreads
            .FirstOrDefault(t => t.Title.Contains(ThreadTitle));

        if (_thread == null)
        {
            _threadNotExist = true;
            return;
        }
        ThreadContent = Ts.ReadAllMessages(_thread.Id);

        UpdateAccess();
    }
    
    private void UpdateAccess()
    {
        if (_thread == null)
            return;
        
        bool isJoined =
            User?.UserName is { } userName &&
            (_thread.JoinedUsers?.Contains(userName) ?? false);

        _canAccess = !_thread.IsPrivate ||
                     isJoined ||
                     (User?.Audit ?? false);
    }

    private string GetThreadTitle(ChatThread thread)
    {
        return thread.Title;
    }

    private IEnumerable<ChatThread> Filtered =>
        (ShowJoinedThreads
            ? _allThreads.Where(t => User != null && 
                                     t.JoinedUsers.Contains(User!.UserName))
            : _allThreads)
        .Where(t =>
            _search == "" ||
            t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(t => int.Parse(t.Id));
    private void HandleNewMessages(string threadId)
    {
        if (_thread?.Id == threadId)
        {
            Ns.LastChecked(User!.Id, threadId);
            LoadCurrentThread();
        }

        _allThreads = Ts.GetThreads();

        InvokeAsync(StateHasChanged);
    }
    
    private void HandleEditedThread()
    {
        _allThreads = Ts.GetThreads();
        if (User != null)
        {
            _joinedThreads = Ts.GetJoinedThreads(User.UserName);
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleChangedAccess(bool access)
    {
        _canAccess = access;
    }

    private Task SendMessage(string message)
    {
        if (_thread != null && User != null)
        {
            Ts.SendMessage(User, _thread.Id, message, _parentPostId);
        }

        return Task.CompletedTask;
    }
    
    public int Notifications(ChatThread thread)
    {
        if (_joinedThreads.All(t => t.Id != thread.Id)) return 0;
        Log? log = Ns.GetThreadLog(User!.Id, thread.Id);
        return log != null ? thread.Posts.Count(p => p.TimeStamp > log.Time && p.Author != User.UserName) : 0;
    }

    private void ReadPosts(ChatThread thread)
    {
        if (User == null) return; 
        if (_joinedThreads.Any(t => t.Id == thread.Id))
        {
            Ns.LastChecked(User.Id, thread.Id);

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Ts.NewMessages -= HandleNewMessages;
        Ts.ThreadsChanged -= HandleEditedThread;
    }
}
