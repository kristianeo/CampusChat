@rendermode InteractiveServer
@inject ThreadService Ts
@inject UserService Us
@implements IDisposable
@inject NavigationManager Nav

<div class="container text-left">
    <div class="row">
        <div class="col">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <a class="navbar-brand">Threads</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarText">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarText">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="btn" @onclick='() => _joinedThreads = ""'>All</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn" @onclick='() => _joinedThreads = _user.UserName'>Joined</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn" @onclick='() => Console.WriteLine("Clicked")'>Private messages</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            
            <input type="text" 
                       class="form-control" 
                       @bind="_search"
                       placeholder="Search"
                       @bind:event="oninput">
                
                <div class="list-group">
                    @foreach (ChatThread thread in Filtered.Skip((Page - 1) * 10).Take(10))
                    {
                        <button type="button" 
                                class="list-group-item list-group-item-action"
                                value="@thread.Id"
                                @onclick="() => Choose(thread)">
                            @thread.Title
                        </button>
                    }
                </div>
                
                <ThreadsPagination Page="Page" Threads="Filtered" JoinedThreads="@_joinedThreads"></ThreadsPagination>
        </div>
        <div class="col">
            <div class="panel panel-default">
                <div class="panel-heading"><h1>@_thread?.Title</h1></div>
                <div class="panel-body">
                    @if (_thread != null && _user != null)
                    {
                        @if (!_thread.JoinedUsers.Contains(_user.UserName))
                        {
                            <button type="button" class="btn btn-outline-success"
                                    @onclick='() => Ts.JoinThread(_user, _thread)'>Join thread</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger"
                                    @onclick='() => Ts.LeaveThread(_user, _thread)'>Leave thread</button>
                        }
                    }
                    <div class="list-group list-group-flush overflow-auto" style="height:400px;">

                        @foreach (var post in ThreadContent.Where(p => p.ParentPostId == ""))
                        {
                            <PostItem Post="post"
                                      ThreadContent="ThreadContent"
                                      @bind-ParentPostId="@_parentPostId">
                            </PostItem>
                        }
                    </div>
                </div>
            </div>
            @if (_parentPostId != "")
            {
                <p>Reply to: @Ts.GetPost(_parentPostId).Message</p>
            }
            <ThreadInput ThreadId="@_thread?.Id" ParentPostId="@_parentPostId"></ThreadInput>
        </div>
    </div>
</div>



@code {
    [Parameter] public int Page { get; set; }
    private List<Post> ThreadContent { get; set; } = [];
    private ChatThread? _thread;
    private List<ChatThread> _allThreads = new();
    private Profile? _user { get; set; }
    private string _search = "";
    private string? _parentPostId = "";
    private string? _joinedThreads = "";
    private async Task Choose(ChatThread thread) 
    {
        await Us.SaveThreadAsync(thread);
        
        Us.SelectedThread();

        if (_thread != null)
        {
            ThreadContent = Ts.ReadAllMessages(_thread.Id);
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _user = await Us.LoadUserAsync();
            StateHasChanged();
        }
    }
    
    protected override void OnInitialized()
    {
        _allThreads = Ts.GetThreads();
        Ts.NewMessages += HandleNewMessages;
        Us.ChangeThread += HandleChangedThread;
        Ts.ThreadsChanged += HandleEditedThread;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _thread = await Us.LoadThreadAsync() ?? _allThreads[0];
    }

    private IEnumerable<ChatThread> Filtered =>
        _allThreads
            .Where(t =>
                (_search == "" ||
                 t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
                (_joinedThreads == "" ||
                 t.JoinedUsers.Contains(_joinedThreads, StringComparer.OrdinalIgnoreCase))
            )
            .OrderBy(t => int.Parse(t.Id));
            

    private IEnumerable<Post> PostReplies(string parentPostId)
    {
        return ThreadContent
            .Where(p => !string.IsNullOrEmpty(p.ParentPostId) &&
                        p.ParentPostId == parentPostId);
    }

    private void HandleNewMessages()
    {
        if (_thread == null) return;
        
        InvokeAsync(() =>
        {
            ThreadContent = Ts.ReadAllMessages(_thread.Id);
            StateHasChanged();
        });
    }

    private async void HandleChangedThread()
    {
        _thread = await Us.LoadThreadAsync();
        await InvokeAsync(StateHasChanged);
    }
    
    private async void HandleEditedThread()
    {
        _allThreads = Ts.GetThreads();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Ts.NewMessages -= HandleNewMessages;
    }
}}