@rendermode InteractiveServer
@inject ThreadService Ts

<div class="container" style="width: 50%">
    <h1>@_thread.Title</h1>
    <textarea class="form-control" 
              rows="5" 
              id="comment" readonly>
            @ThreadContent
    </textarea>
    <ThreadInput OnMessageAdded="@RefreshMessages"></ThreadInput>
</div>

@code {
    [Parameter] public required string ThreadId { get; set; }
    private string ThreadContent { get; set; } = "";
    private ChatThread? _thread;
    
    
    private void RefreshMessages()
    {
        ThreadContent = Ts.ReadAllMessages(ThreadId);
    }
    
    protected override void OnInitialized()
    {
        _thread = Ts.GetThread(ThreadId);
        ThreadContent = Ts.ReadAllMessages(ThreadId);
    }
    
    //TODO: Fix possible null reference 
   
}