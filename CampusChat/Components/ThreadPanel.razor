@rendermode InteractiveServer
@inject ThreadService Ts
@inject UserService Us
@implements IDisposable

<div class="container text-left">
    <div class="row">
        <div class="col">
            
            <ThreadsNavBar ChooseThreads="HandleChangedThreads"></ThreadsNavBar>
            
            <input type="text" 
                   class="form-control" 
                   @bind="_search"
                   placeholder="Search"
                   @bind:event="oninput">
            
            <SelectableList T="ChatThread"
                            List="Filtered.Skip((Page - 1) * 10).Take(10)"
                            ItemText="GetThreadTitle"
                            Selected="Choose" />
            
            <ThreadsPagination Page="Page" 
                               Threads="Filtered"></ThreadsPagination>
        </div>
        <div class="col">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <div class="d-flex align-items-center">
                        <h1 class="mb-0">@_thread?.Title</h1>

                        <div class="ms-auto">
                            <JoinOrLeaveThreadButton Thread="_thread"
                                                     User="User" />
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="list-group list-group-flush overflow-auto" style="height:400px;">
                        @if (!_canAccess)
                        {
                            <PrivateThread CanAccess="_canAccess"
                                           ThreadPassword="@_thread.AccessCode"
                                           IsValid="HandleChangedAccess">
                            </PrivateThread>
                        }

                        @if (_canAccess)
                        {
                            @foreach (var post in ThreadContent.Where(p => p.ParentPostId == ""))
                            {
                                <PostItem Post="post"
                                          ThreadContent="ThreadContent"
                                          @bind-ParentPostId="@_parentPostId">
                                </PostItem>
                            }
                        }
                    </div>
                </div>
                <MessageInput OnSend="SendMessage"></MessageInput>
                
            </div>
            
            
            
        </div>
    </div>
</div>

@code {
    [Parameter] public int Page { get; set; }
    private List<Post> ThreadContent { get; set; } = [];
    private ChatThread? _thread;
    private List<ChatThread> _allThreads = new();
    private Profile? User { get; set; }
    private string _search = "";
    private string? _parentPostId = "";
    private string? _joinedThreads = "";
    private bool _canAccess;
    private async Task Choose(ChatThread thread)
    {
        _thread = thread;

        ThreadContent = Ts.ReadAllMessages(_thread.Id);
        _canAccess = !_thread.IsPrivate;
        
        await Us.SaveThreadAsync(thread);
    }
    private string GetThreadTitle(ChatThread thread)
    {
        return thread.Title;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            User = await Us.LoadUserAsync();
            StateHasChanged();
        }
    }
    
    protected override void OnInitialized()
    {
        _allThreads = Ts.GetThreads();
        _thread = _allThreads.FirstOrDefault();
        
        Ts.NewMessages += HandleNewMessages;
        Ts.ThreadsChanged += HandleEditedThread;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _thread = await Us.LoadThreadAsync() ?? _allThreads.FirstOrDefault();
        
        if (_thread != null)
        {
            ThreadContent = Ts.ReadAllMessages(_thread.Id);
            _canAccess = !_thread.IsPrivate;
        }
    }

    private IEnumerable<ChatThread> Filtered =>
        _allThreads
            .Where(t =>
                (_search == "" ||
                 t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
                (_joinedThreads == "" ||
                 t.JoinedUsers.Contains(_joinedThreads, StringComparer.OrdinalIgnoreCase))
            )
            .OrderBy(t => int.Parse(t.Id));

    private void HandleNewMessages()
    {
        if (_thread == null) return;
        
        InvokeAsync(() =>
        {
            ThreadContent = Ts.ReadAllMessages(_thread.Id);
            StateHasChanged();
        });
    }
    
    private void HandleEditedThread()
    {
        _allThreads = Ts.GetThreads();
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleChangedThreads(string joinedThreads)
    {
        _joinedThreads = joinedThreads;
        Page = 1;
    }

    private void HandleChangedAccess()
    {
        _canAccess = true;
    }
    
    private Task SendMessage(string message)
    {
        Console.WriteLine("Sending: " + message);
        if (_thread != null && User != null)
        {
            Ts.SendMessage(User, _thread.Id, message, _parentPostId);
            Console.WriteLine($"Count after send: {Ts.ReadAllMessages(_thread.Id).Count}");
        }

        return Task.CompletedTask;
    }


    public void Dispose()
    {
        Ts.NewMessages -= HandleNewMessages;
        Ts.ThreadsChanged -= HandleEditedThread;
    }
}}