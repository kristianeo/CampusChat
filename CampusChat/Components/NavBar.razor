<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">CampusChat</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarText">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarText">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="btn btn-small p-2" href="/Threads" Match="NavLinkMatch.All">
                        <small>All threads</small>
                    </NavLink>
                </li>
                <li class="nav-item mb-0">
                    <NavLink class="@($"btn btn-small p-2 {(IsDisabled() ? "disabled" : "")}")" href="/Threads/JoinedThreads">
                        <small>My threads</small>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="@($"btn btn-small p-2 {(IsDisabled() ? "disabled" : "")}")" href="/Messages">
                        <small>Messages</small>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="btn btn-small p-2" href="/Profiles" Match="NavLinkMatch.All">
                        <small>Profiles</small>
                    </NavLink>
                </li>
                @if (User != null)
                {
                <li class="nav-item">
                    <NavLink class="@($"btn btn-small p-2 {(IsDisabled() ? "disabled" : "")}")" href=@($"/Profiles/{User.UserName}") Match="NavLinkMatch.All">
                        <small>My profile</small>
                    </NavLink>
                </li>
                }
                
                
                <li class="nav-item">
                    @if (IsLoggedIn)
                    {
                        <LogoutButton></LogoutButton>
                    }
                    @if (!IsLoggedIn)
                    {
                        <LoginButton></LoginButton>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    [Parameter] public bool IsLoggedIn { get; set; }
    [Parameter] public Profile? User { get; set; }

    private bool IsDisabled()
    {
        return User == null;
    }
    
    
}