@rendermode InteractiveServer
@inject ThreadService Ts
@inject UserService Us

<div class="input-group mb-3">
    <input type="text" 
           class="form-control" 
           placeholder="Say something..." 
           @bind="_chatMessage">
    <button class="btn btn-outline-secondary" 
            type="button" 
            @onclick="SendMessage">Send</button>
</div>

@code {
    [Parameter] public required string ThreadId { get; set; }
    [Parameter] public string ParentPostId { get; set; } = "";
    private string _chatMessage = "";
    private Post? post;
    
    private async Task SendMessage()
    {
        var user = await Us.LoadUserAsync();
        var thread = await Us.LoadThreadAsync();
        post = Ts.AddPost(user!, thread!, _chatMessage, ParentPostId);
        Ts.AddMessage(post);
        _chatMessage = string.Empty;
    }
    
}