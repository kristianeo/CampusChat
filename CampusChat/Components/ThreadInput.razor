@rendermode InteractiveServer
@inject ThreadService Ts
@inject AppState As

<div class="input-group mb-3">
    <input type="text" 
           class="form-control" 
           placeholder="Say something..." 
           @bind="_chatMessage">
    <button class="btn btn-outline-secondary" 
            type="button" 
            @onclick="SendMessage">Send</button>
</div>

@code {
    private string _chatMessage = "";
    private Post? post;

    [Parameter] public EventCallback OnMessageAdded { get; set; }
    
    private async Task SendMessage()
    {
        post = Ts.AddPost(As.ActiveUser, _chatMessage, "1", "2");
        Ts.AddMessage(post);
        _chatMessage = string.Empty;

        await OnMessageAdded.InvokeAsync();
    }
    
}