@inject NavigationManager Nav
@inject UserService Us
@rendermode InteractiveServer

<div class="container" style="width: 20%">
    <h1>Log in</h1>
    
    <SelectInput T="Profile"
                 @bind-Value="_user"
                 Options="_profiles"
                 Message="Select a user:">
    </SelectInput>
    
    <button type="button"
            class="btn btn-primary"
            @onclick="LoggingIn">
        Log in
    </button> 
</div>

@code {
    private List<Profile> _profiles { get; set; } = [];
    private Profile _user { get; set; }

    private void LoggingIn()
    {
        Us.SaveUserAsync(_user);
        Nav.NavigateTo($"/Profile/{_user.UserName}");
    }

    protected override void OnInitialized()
    {
        _profiles = jsonReader.LoadProfiles();
    }

}