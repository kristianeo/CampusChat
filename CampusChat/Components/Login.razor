@inject NavigationManager Nav
@inject UserService Us
@rendermode InteractiveServer

<div class="container" style="width: 20%">
    <h1>Log in</h1>
    
    <SelectInput T="string"
                 @bind-Value="_userName"
                 Options="_profiles"
                 Message="Select a user:">
    </SelectInput>
    
    <button type="button"
            class="btn btn-primary"
            @onclick="LoggingIn">
        Log in
    </button> 
</div>

@code {
    private List<string> _profiles { get; set; } = [];
    private string _userName { get; set; }
    private Profile _user { get; set; }

    private async Task LoggingIn()
    {
        _user = Us.GetProfile(_userName)!;
        await Us.SaveUserAsync(_user);
        Nav.NavigateTo($"/Profile/{_user.UserName}");
    }

    protected override void OnInitialized()
    {
        Us.GetProfiles();
        _profiles = new List<string>(Us.AllProfiles.Select(p => p.UserName));
    }

}