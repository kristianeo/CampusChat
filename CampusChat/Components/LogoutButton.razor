@inject UserService Us
@inject NavigationManager Nav

<button type="button"
        class="btn btn-small p-2 btn-danger"
        @onclick="LoggingOut">
    <small>Log out</small>
</button> 

@code {

    private async Task LoggingOut()
    {
        await Us.ClearUserAsync();
        Nav.NavigateTo("/Login");
    }
}