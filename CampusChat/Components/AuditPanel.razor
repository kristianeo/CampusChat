@rendermode InteractiveServer
@inject DirectMessageService Dms
@inject UserService Us
@inject NavigationManager Nav

<SplitPanel>
    <LeftContent>
        <NavBar IsLoggedIn="_isLoggedIn"/>

        <input class="form-control"
               type="text" 
               @bind="_search"
               placeholder="Search"
               @bind:event="oninput" />

        <SelectableList T="DirectMessage"
                        List="Filtered"
                        ItemText="GetProfileUsername"
                        Selected="Choose" />
    </LeftContent>

    <Header>
        <h3 class="mb-0">@Username</h3>
    </Header>

    <Body>
    @foreach (Message message in MessageContent)
    {
        <DmItem Message="message"></DmItem>
    }
    </Body>

</SplitPanel>

@code {
    
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public int Page { get; set; }
    private List<DirectMessage> _allDms = [];
    private DirectMessage? _currentDm;
    private List<Message> MessageContent { get; set; } = [];
    private string _search = "";
    private Profile? User { get; set; }
    private bool _isLoggedIn;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        User = await Us.LoadUserAsync();
        
        _isLoggedIn = User != null;

        if (_isLoggedIn)
        {
            _isLoggedIn = true;
            _allDms = Dms.GetDirectMessages();

            LoadCurrentDm();
        }
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        Dms.UpdateDirectMsgs += HandleNewMessages;
    }

    protected override void OnParametersSet()
    {
        LoadCurrentDm();
    }
    
    private void LoadCurrentDm()
    {
        if (_allDms.Count == 0)
            return;

        _currentDm = _allDms
            .FirstOrDefault();

        MessageContent = _currentDm != null
            ? Dms.ReadAllMessages(_currentDm.Id)
            : [];
    }

    private void Choose(DirectMessage dm)
    {
        Nav.NavigateTo($"/Messages/Audit/{GetProfileUsername(dm)}");
    }
    
    private string GetProfileUsername(DirectMessage dm)
    {
        return $"{dm.Participants[0]}, {dm.Participants[1]}";
    }

    private IEnumerable<DirectMessage> Filtered =>
        _allDms
            .Where(m =>
                _search == "" ||
                m.Participants
                    .Any(p => p.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(d =>
                d.Messages.LastOrDefault()?.TimeStamp ?? DateTime.MinValue);

    private void HandleNewMessages(string dmId)
    {
        InvokeAsync(() =>
        {
            _allDms = Dms.GetDirectMessages();
            
            if (_currentDm?.Id == dmId)
            {
                var dm = _allDms.FirstOrDefault(d => d.Id == dmId);

                if (dm != null)
                {
                    MessageContent = dm.Messages;
                    _currentDm = dm;
                }
            }
            
            StateHasChanged();
        });
    }
    
}