
<div class="rounded-circle @GetAvatarColor() text-white d-flex
            justify-content-center align-items-center"
     style="width:50px;height:50px;">
    @if (Username != null)
    {
        @Username[0].ToString().ToUpper()
    }
</div>

@code {
    [Parameter] public string Username { get; set; }
    [Parameter] public string AvatarColor { get; set; }

    private string GetAvatarColor()
    {
        string avatarColor = "";
        if (Username != null)
        {
            Profile? _profile = jsonReader.GetProfile(Username);
            avatarColor = _profile.AvatarColor;
        }

        if (AvatarColor != null)
        {
            avatarColor = AvatarColor;
        }

        return avatarColor;
    }
}