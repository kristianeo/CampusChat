@inject ThreadService Ts
@inject UserService Us
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container text-left">
    <div class="row">
        <div class="col">
            <div class="container">
                <h1>All threads</h1>
    
                <div class="list-group">
                    @foreach (ChatThread thread in _allThreads)
                    {
                        <button type="button" 
                                class="list-group-item list-group-item-action"
                                value="@thread.Id"
                                @onclick="() => Choose(thread)">
                            @thread.Title
                        </button>
                    }
                </div>
    
            </div>
        </div>
        <div class="col">
            <div class="container">
                <ThreadPanel ThreadId="@_threadID"></ThreadPanel>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ChatThread> _allThreads = new();
    private string _threadID { get; set; }

    private async Task Choose(ChatThread thread) 
    {
        await Us.SaveThreadAsync(thread);
        _threadID = thread.Id;
    }

    protected override void OnInitialized()
    {
        _allThreads = Ts.GetThreads();
    }
}