@rendermode InteractiveServer
@inject DirectMessageService Dms
@inject UserService Us
@inject AuditService As
@implements IDisposable
@inject NavigationManager Nav

<SplitPanel>
    <LeftContent>
        <NavBar IsLoggedIn="_isLoggedIn"
                User="User"/>
        
        @if (User is { Audit: true })
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" 
                       @bind="As.IsAuditModeEnabled"
                       @bind:after="RefreshMessages">
                <label class="form-check-label" for="switchCheckDefault">Audit role</label>
            </div>
        }

        <input class="form-control"
               type="text" 
               @bind="_search"
               placeholder="Search"
               @bind:event="oninput" />

        <SelectableList T="DirectMessage"
                        List="Filtered"
                        ItemText="GetProfileUsername"
                        Notifications="NotificationCount"
                        Selected="Choose" />
    </LeftContent>

    <Header>
        <h3 class="mb-0">@(_currentDm != null ? GetProfileUsername(_currentDm) : "")</h3>
    </Header>

    <Body>
    @if (_currentDmNotExist)
    {
        <p class="lead">The address you are trying to reach does not exist.</p>
        <p class="lead">Please select a user from the list or look at the profiles 
            page to find new people to connect with!</p>
    }
    
    @if (!_currentDmNotExist && MessageContent.Count == 0)
    {
        <p class="lead">Be the first to send a message!</p>
    }
    @foreach (Message message in MessageContent)
    {
        <DmItem Message="message"></DmItem>
    }
    </Body>

    <Footer>
        <MessageInput OnSend="SendMessage"
                      IsLoggedIn="_isLoggedIn"></MessageInput>
    </Footer>

</SplitPanel>

@code
{
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public string DmId { get; set; } = "";
    private Profile? User { get; set; }
    private List<DirectMessage> _userDms = [];
    private DirectMessage? _currentDm;
    private bool _currentDmNotExist;
    private List<Message> MessageContent { get; set; } = [];
    private string _search = "";
    private bool _isLoggedIn;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        User = await Us.LoadUserAsync();
        
        _isLoggedIn = User != null;

        if (_isLoggedIn)
        {
            _isLoggedIn = true;

            RefreshMessages();
        }
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        Dms.UpdateDirectMsgs += HandleNewMessages;
    }

    protected override void OnParametersSet()
    {
        LoadCurrentDm();
    }
    
    private void LoadCurrentDm()
    {
        if (_userDms.Count == 0)
            return;
        
        bool hasSetParameter =
            !string.IsNullOrWhiteSpace(DmId) ||
            !string.IsNullOrWhiteSpace(Username);

        if (!hasSetParameter)
            return;

        if (User!.Audit && As.IsAuditModeEnabled)
        {
            _currentDm = _userDms.FirstOrDefault(d => d.Id == DmId);
        }
        else
        {
            _currentDm = _userDms.FirstOrDefault(d => d.Participants.Contains(Username));
        }

        if (_currentDm == null) _currentDmNotExist = true;

        MessageContent = Dms.ReadAllMessages(_currentDm.Id);
    }

    private void Choose(DirectMessage dm)
    {
        ReadMessages(dm);
        
        if (User!.Audit && As.IsAuditModeEnabled)
        {
            Nav.NavigateTo($"/Messages/Dm/{dm.Id}");
            return;
        }
        
        Nav.NavigateTo($"/Messages/User/{GetProfileUsername(dm)}");
    }
    
    private string GetProfileUsername(DirectMessage dm)
    {
        if (User!.Audit && As.IsAuditModeEnabled)
        {
            return $"{dm.Participants[0]}, {dm.Participants[1]}";
        }

        return User == null ? "" : dm.Participants.Single(d => d != User.UserName).ToString();

    }

    private IEnumerable<DirectMessage> Filtered =>
        _userDms
            .Where(m =>
                _search == "" ||
                m.Participants
                    .Any(p => p.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(d =>
                d.Messages.LastOrDefault()?.TimeStamp ?? DateTime.MinValue);

    private void HandleNewMessages(string dmId)
    {
        InvokeAsync(() =>
        {
            RefreshMessages();
            if (_currentDm?.Id == dmId)
            {
                var dm = _userDms.FirstOrDefault(d => d.Id == dmId);

                if (dm != null)
                {
                    ReadMessages(dm);
                    MessageContent = dm.Messages;
                    _currentDm = dm;
                }
            }
            
            StateHasChanged();
        });
    }

    private void RefreshMessages()
    {
        if (User!.Audit && As.IsAuditModeEnabled)
        {
            _userDms = Dms.GetDirectMessages();
            ArchiveMessages();
            DeleteOldMessages();
        }
        else
        {
            _userDms = Dms.GetUserDms(User).Where(dm => !dm.Archived).ToList();
        }
        
        LoadCurrentDm();
    }

    private void SendMessage(string message)
    {
        if (_currentDm == null)
            return;

        if (User?.Audit == true && As.IsAuditModeEnabled)
            return;

        Dms.SendMessage(User!, message, _currentDm.Id);
    }

    private int NotificationCount(DirectMessage dm)
    {
        if (User?.Audit == true && As.IsAuditModeEnabled)
            return 0;
        
        return dm.Messages
            .Count(m =>
                !m.IsRead && m.Author != User!.UserName);
    }
    
    private void ReadMessages(DirectMessage dm)
    {
        if (User!.Audit && As.IsAuditModeEnabled) return;
        
        bool changed = false;

        foreach (Message message in dm.Messages
                     .Where(m => m.Author != User!.UserName && !m.IsRead))
        {
            message.IsRead = true;
            changed = true;
        }

        if (changed)
        {
            Dms.UpdateMessage(dm);
        }
    }
    
    private void ArchiveMessages()
    {
        List<DirectMessage> messages = Dms.GetDirectMessages();
        List<Profile> profiles = Us.GetProfiles();
        foreach (var dm in messages)
        {
            var participants = profiles
                .Where(p => dm.Participants.Contains(p.UserName));

            Profile? profile = participants.FirstOrDefault(p => p.Graduated);

            if (profile != null)
            {
                if (!dm.Archived)
                 {
                    dm.Archived = true;
                    dm.ArchiveDate = profile.GraduationDate;
                 }
            }
            Dms.UpdateMessage(dm);
        }
    }

    private void DeleteOldMessages()
    {
        List<DirectMessage> messages = Dms.GetDirectMessages();

        foreach (var directMessage in messages.Where(directMessage => directMessage.Archived).ToList()
                     .Where(directMessage => DateTime.Now.AddYears(-3) >= directMessage.ArchiveDate))
        {
            Dms.DeleteDirectMessage(directMessage);
        }
    }
    

    public void Dispose()
    {
        Dms.UpdateDirectMsgs -= HandleNewMessages;
    }
}