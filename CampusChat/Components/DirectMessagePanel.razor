@rendermode InteractiveServer
@inject DirectMessageService Dms
@inject UserService Us
@implements IDisposable
@inject NavigationManager Nav

<div class="container text-left">
    <div class="row">
        <div class="col">
            <NavBar></NavBar>

            <input type="text"
                   class="form-control"
                   @bind="_search"
                   placeholder="Search"
                   @bind:event="oninput">

            <SelectableList T="DirectMessage"
                            List="Filtered.Skip((Page - 1) * 10).Take(10)"
                            ItemText="GetProfileUsername"
                            Notifications="NotificationCount"
                            Selected="Choose"></SelectableList>
            
            <Pagination Page="Page"
                        ItemCount="Filtered.Count()"
                        ChangedPage="HandleChangedPage"></Pagination>

        </div>
        <div class="col">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <div class="d-flex align-items-center">
                        <h1 class="mb-0">@Username</h1>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="list-group list-group-flush overflow-auto"
                         style="height: 400px;">
                        @foreach (Message message in MessageContent)
                        {
                            <DmItem Message="message"></DmItem>
                        }
                    </div>
                </div>
                <MessageInput OnSend="SendMessage"></MessageInput>
            </div>
        </div>
    </div>
</div>
    

@code {
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public int Page { get; set; }
    private List<DirectMessage> _userDms = [];
    private DirectMessage? _currentDm;
    private List<Message> MessageContent { get; set; } = [];
    private string _search = "";
    private Profile? User { get; set; }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        User = await Us.LoadUserAsync();

        _userDms = Dms.GetUserDms(User!);
        
        LoadCurrentDm();

        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        Dms.UpdateDirectMsgs += HandleNewMessages;
    }

    protected override void OnParametersSet()
    {
        LoadCurrentDm();
    }
    
    private void LoadCurrentDm()
    {
        if (_userDms.Count == 0)
            return;

        _currentDm = _userDms
            .FirstOrDefault(dm => dm.Participants.Contains(Username));

        MessageContent = _currentDm != null
            ? Dms.ReadAllMessages(_currentDm.Id)
            : [];
    }

    private void Choose(DirectMessage dm)
    {
        ReadMessages(dm);
        Nav.NavigateTo($"/Messages/{GetProfileUsername(dm)}");
    }
    
    private string GetProfileUsername(DirectMessage dm)
    {
        return User == null ? "" : dm.Participants.Single(d => d != User.UserName).ToString();
    }

    private IEnumerable<DirectMessage> Filtered =>
        _userDms
            .Where(m =>
                _search == "" ||
                m.Participants
                    .Any(p => p.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(d =>
                d.Messages.LastOrDefault()?.TimeStamp ?? DateTime.MinValue);

    private void HandleNewMessages(string dmId)
    {
        InvokeAsync(() =>
        {
            _userDms = Dms.GetUserDms(User!);
            
            if (_currentDm?.Id == dmId)
            {
                var dm = _userDms.FirstOrDefault(d => d.Id == dmId);

                if (dm != null)
                {
                    ReadMessages(dm);
                    MessageContent = dm.Messages;
                    _currentDm = dm;
                }
            }
            
            StateHasChanged();
        });
    }

    private void HandleChangedPage(int page)
    {
        Page = page;
    }

    private void SendMessage(string message)
    {
        if (_currentDm != null)
        {
            Dms.SendMessage(User!.UserName, message, _currentDm.Id);
        }
    }

    private int NotificationCount(DirectMessage dm)
    {
        return dm.Messages
            .Count(m =>
                !m.IsRead && m.Author != User!.UserName);
    }
    
    private void ReadMessages(DirectMessage dm)
    {
        bool changed = false;

        foreach (Message message in dm.Messages
                     .Where(m => m.Author != User!.UserName && !m.IsRead))
        {
            message.IsRead = true;
            changed = true;
        }

        if (changed)
        {
            Dms.UpdateMessage(dm);
        }
    }
    

    public void Dispose()
    {
        Dms.UpdateDirectMsgs -= HandleNewMessages;
    }
    

}