@rendermode InteractiveServer
@inject DirectMessageService Dms
@inject UserService Us
@inject AuditService As
@implements IDisposable
@inject NavigationManager Nav

<SplitPanel>
    <LeftContent>
        <NavBar IsLoggedIn="_isLoggedIn"/>
        
        @if (User is { Audit: true })
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" 
                       @bind="As.IsAuditModeEnabled"
                       @bind:after="RefreshMessages">
                <label class="form-check-label" for="switchCheckDefault">Audit role</label>
            </div>
        }

        <input class="form-control"
               type="text" 
               @bind="_search"
               placeholder="Search"
               @bind:event="oninput" />

        <SelectableList T="DirectMessage"
                        List="Filtered"
                        ItemText="GetProfileUsername"
                        Notifications="NotificationCount"
                        Selected="Choose" />
    </LeftContent>

    <Header>
        <h3 class="mb-0">@_username</h3>
    </Header>

    <Body>
        @foreach (Message message in MessageContent)
        {
            <DmItem Message="message"></DmItem>
        }
    </Body>

    <Footer>
        <MessageInput OnSend="SendMessage"
                      IsLoggedIn="_isLoggedIn"></MessageInput>
    </Footer>

</SplitPanel>

@code
{
    
    [Parameter] public string DmId { get; set; } = "";
    private Profile? User { get; set; }
    private List<DirectMessage> _userDms = [];
    private DirectMessage? _currentDm;
    private string _username = "";
    private List<Message> MessageContent { get; set; } = [];
    private string _search = "";
    private bool _isLoggedIn;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        User = await Us.LoadUserAsync();
        
        _isLoggedIn = User != null;

        if (_isLoggedIn)
        {
            _isLoggedIn = true;
            RefreshMessages();

            LoadCurrentDm();
        }
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        Dms.UpdateDirectMsgs += HandleNewMessages;
    }

    protected override void OnParametersSet()
    {
        LoadCurrentDm();
    }
    
    private void LoadCurrentDm()
    {
        if (_userDms.Count == 0)
            return;

        _currentDm = _userDms.FirstOrDefault(d => d.Id == DmId);

        if (_currentDm == null) return;
        _username = GetProfileUsername(_currentDm);
        MessageContent = Dms.ReadAllMessages(_currentDm.Id);
    }

    private void Choose(DirectMessage dm)
    {
        ReadMessages(dm);
        
        Nav.NavigateTo($"/Messages/{dm.Id}");
    }
    
    private string GetProfileUsername(DirectMessage dm)
    {
        if (User!.Audit && As.IsAuditModeEnabled)
        {
            return $"{dm.Participants[0]}, {dm.Participants[1]}";
        }

        return User == null ? "" : dm.Participants.Single(d => d != User.UserName).ToString();

    }

    private IEnumerable<DirectMessage> Filtered =>
        _userDms
            .Where(m =>
                _search == "" ||
                m.Participants
                    .Any(p => p.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(d =>
                d.Messages.LastOrDefault()?.TimeStamp ?? DateTime.MinValue);

    private void HandleNewMessages(string dmId)
    {
        RefreshMessages();
        
        InvokeAsync(() =>
        {
            if (_currentDm?.Id == dmId)
            {
                var dm = _userDms.FirstOrDefault(d => d.Id == dmId);

                if (dm != null)
                {
                    ReadMessages(dm);
                    MessageContent = dm.Messages;
                    _currentDm = dm;
                }
            }
            
            StateHasChanged();
        });
    }

    private void RefreshMessages()
    {
        _userDms = User!.Audit && As.IsAuditModeEnabled
            ? Dms.GetDirectMessages()
            : Dms.GetUserDms(User);
        
        LoadCurrentDm();
        
        StateHasChanged();
    }

    private void SendMessage(string message)
    {
        if (_currentDm == null)
            return;

        if (User?.Audit == true && As.IsAuditModeEnabled)
            return;

        Dms.SendMessage(User!.UserName, message, _currentDm.Id);
    }

    private int NotificationCount(DirectMessage dm)
    {
        if (User?.Audit == true && As.IsAuditModeEnabled)
            return 0;
        
        return dm.Messages
            .Count(m =>
                !m.IsRead && m.Author != User!.UserName);
    }
    
    private void ReadMessages(DirectMessage dm)
    {
        if (User!.Audit && As.IsAuditModeEnabled) return;
        
        bool changed = false;

        foreach (Message message in dm.Messages
                     .Where(m => m.Author != User!.UserName && !m.IsRead))
        {
            message.IsRead = true;
            changed = true;
        }

        if (changed)
        {
            Dms.UpdateMessage(dm);
        }
    }
    

    public void Dispose()
    {
        Dms.UpdateDirectMsgs -= HandleNewMessages;
    }
}