@rendermode InteractiveServer
@inject UserService Us
@inject ThreadService Ts

@if (ParentPostId == Post.Id)
{
    <strong class="mb-0">Replying to: </strong>
}
<div class="list-group-item list-group-item-action p-2 @(ParentPostId == Post.Id ? "selected-post" : "")"
     @onclick="() => SelectPost(Post.Id)">
    <div class="d-flex gap-2 align-items-start">

        <div class="flex-shrink-0">
            <Avatar Username="@Post.Author"></Avatar>
        </div>

        <div class="flex-grow-1" style="min-width:0;">
            <div>
                <strong>@Post.Author</strong>
                <small class="text-muted">
                    @Post.TimeStamp.ToString("t")
                </small>
            </div>

            <div>
                @if (Post.Message == "This message has been deleted")
                {
                    <i>@Post.Message</i>
                }
                else
                @Post.Message
            </div>
            <div>
                @if (CanDelete(Post))
                {
                    <button type="button"
                            class="btn btn-danger btn-sm mt-2"
                            @onclick:stopPropagation="true"
                            @onclick="() => Ts.DeleteMessage(Post)">
                        Delete
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@foreach (var reply in PostReplies(Post.Id))
{
    <div class="ms-4">
        <PostItem Post="reply"
                  ThreadContent="ThreadContent"
                  ParentPostId="@ParentPostId"
                  ParentPostIdChanged="@ParentPostIdChanged">
        </PostItem>
    </div>
}

@code {
    [Parameter] public required List<Post> ThreadContent { get; set; }
    [Parameter] public required Post Post { get; set; }
    [Parameter] public EventCallback<string> ParentPostIdChanged { get; set; }
    [Parameter] public string ParentPostId { get; set; } = "";
    private Profile? _user { get; set; }
    
    private async Task SelectPost(string postId)
    {
        var selectedId = ParentPostId == postId
            ? ""
            : postId;
        
        await ParentPostIdChanged.InvokeAsync(selectedId);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _user = await Us.LoadUserAsync();
            StateHasChanged();
        }
    }
    
    private IEnumerable<Post> PostReplies(string parentPostId)
    {
        return ThreadContent
            .Where(p => !string.IsNullOrEmpty(p.ParentPostId) &&
                        p.ParentPostId == parentPostId);
    }

    private bool CanDelete(Post post)
    {
        return ParentPostId == post.Id &&
               post.Author == _user?.UserName &&
               Post.Message != "This message has been deleted";
    }
   
}