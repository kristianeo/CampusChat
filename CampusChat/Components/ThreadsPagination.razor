@rendermode InteractiveServer
@inject NavigationManager Nav

<nav>
    <ul class="pagination">
        <button type="button" 
                class="btn btn-outline-primary" 
                disabled="@(Page <= 1)"
                @onclick='() => Nav.NavigateTo($"/Threads/{Page-1}")'>Previous</button>
        
        @foreach (var pageNumber in Enumerable.Range(1, TotalPages))
        {
            <button type="button"
                    class="btn btn-outline-primary"
                    @onclick='() => Nav.NavigateTo($"/Threads/{pageNumber}")'>
                @pageNumber
            </button>
        }
        
        <button type="button" class="btn btn-outline-primary" disabled="@(Page >= TotalPages)" 
                @onclick='() => Nav.NavigateTo($"/Threads/{Page+1}")'>Next</button>
    </ul>
</nav>

@code {
    [Parameter] public required string JoinedThreads { get; set; }
    [Parameter] public required int Page { get; set; }
    [Parameter] public required IEnumerable<ChatThread> Threads { get; set; }

    private int TotalPages => (int)Math.Ceiling(Threads.Count() / 10.0);
}