@page "/Threads"
@page "/Threads/JoinedThreads"
@page "/Threads/{ThreadTitle}"

@if (ThreadTitle == "JoinedThreads")
{
    <ThreadPanel ShowJoinedThreads="true"></ThreadPanel>
}
else
{
    <ThreadPanel ThreadTitle="@ThreadTitle"></ThreadPanel>
}

@code {
    [Parameter] public string? ThreadTitle { get; set; }
}