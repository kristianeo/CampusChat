@page "/CreateProfile"
@rendermode InteractiveServer

<div class="container text-center">
    <div class="col-sm-8">
        <h1>Create a new profile</h1>
        <form class="row g-3">
            <div class="input-group mb-3">
                <span class="input-group-text" id="Username">@@</span>
                <input type="text" class="form-control" placeholder="Username" @bind="_username">
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text" id="basic-addon2">First name</span>
                <input type="text" class="form-control" placeholder="First name" @bind="_firstname">
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text" id="basic-addon3">Last name</span>
                <input type="text" class="form-control" placeholder="Last name" @bind="_lastname">
            </div>
            <div class="col-md-4">
                <select id="studies" class="form-select" @bind="_studies">
                    <option selected>Choose your studies</option>
                    @foreach (string studies in Enum.GetNames(typeof(Studies)))
                    {
                        <option>@studies</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select id="year" class="form-select" @bind="_startyear">
                    <option selected>Choose your starting year</option>
                    @for (int year = 2024; year < 2028; year++)
                    {
                        <option>@year</option>
                    }
                </select>
            </div>
            <div class="input-group">
                <span class="input-group-text">Write a short note about yourself</span>
                <textarea class="form-control" aria-label="With textarea" @bind="_introduction"></textarea>
            </div>
            <button type="button" class="btn btn-primary" @onclick="@Submit">Submit</button>
        </form>
    </div>
</div>

@inject NavigationManager Nav

@code {
    private string _username;
    private string _firstname;
    private string _lastname;
    private Studies _studies;
    private int _startyear;
    private string _introduction;
    private void CreateNewProfile()
    {
        Profile profile = new Profile(_username, _firstname, _lastname, _studies, _startyear, _introduction);
        Profiles.AllProfiles.Add(profile);
    }

    private void Submit()
    {
        CreateNewProfile();
        Nav.NavigateTo($"/Profile/{_username}");

    }
    
    //TODO: Add validations on inputs
    //TODO: Add .json to store profiles 
   
}